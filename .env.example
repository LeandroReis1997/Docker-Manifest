# Copie para .env na EC2 e preencha com valores fortes (nunca commite o .env).
# cp .env.example .env

# Banco de dados
MYSQL_ROOT_PASSWORD=
DB_NAME=filazero
DB_USER=filazero
DB_PASS=

# Backend
JWT_SECRET=
TZ=America/Sao_Paulo

# URLs publicas
FRONTEND_URL=https://painel.filazerobrasil.com.br
ADMIN_PANEL_URL=https://painel.filazerobrasil.com.br
PASSWORD_RESET_BASE_URL=https://painel.filazerobrasil.com.br
PUBLIC_API_URL=https://api.filazerobrasil.com.br/api
COOKIE_DOMAIN=.filazerobrasil.com.br
COOKIE_SAME_SITE=strict

# Tokens e sessao
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
RESET_PASSWORD_EXPIRES_MINUTES=60
ALLOW_SUPER_ADMIN_WITHOUT_DOMAIN=false

# AWS (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# E-mail (Resend)
RESEND_API_KEY=
RESEND_FROM=Fila Zero <noreply@filazerobrasil.com.br>
EMAIL_LOGO_URL=https://static.filazerobrasil.com.br/painel/logo-filazero-orange.png

# Firebase (push) — coloque o JSON em secrets/firebase-service-account.json (montado no compose)
# Alternativa: JSON minificado em FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
